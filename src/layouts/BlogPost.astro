---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import TagList from '../components/TagList.astro';
import { CATEGORIES, SITE_TITLE, slugify, withBase } from '../consts';

type Props = CollectionEntry<'blog'>['data'] & {
	id: string;
	seriesPosts: CollectionEntry<'blog'>[];
};

const { id, title, description, pubDate, updatedDate, heroImage, category, tags, series, draft, seriesPosts } =
	Astro.props;
const seriesIndex = seriesPosts.findIndex((post) => post.id === id);
const prev = seriesPosts[seriesIndex - 1];
const next = seriesPosts[seriesIndex + 1];
---

<html lang="ko">
	<head>
		<BaseHead title={`${title} | ${SITE_TITLE}`} description={description} image={heroImage} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.hero-image {
				width: 100%;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				border-radius: 12px;
				box-shadow: var(--box-shadow);
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
			}
			.title h1 {
				margin: 0.3em 0;
				font-size: 2.2em;
			}
			.meta {
				color: rgb(var(--gray));
				font-size: 0.85em;
			}
			.meta a {
				color: inherit;
			}
			.draft {
				padding: 0 0.5em;
				border-radius: 4px;
				background: #ffe8a3;
				color: #6b4e00;
			}
			.series {
				margin: 1.5em 0;
				padding: 0.8em 1.2em;
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				background: white;
				font-size: 0.85em;
			}
			.series ol {
				margin: 0.5em 0 0;
			}
			.series .current {
				font-weight: bold;
			}
			.series-nav {
				display: flex;
				justify-content: space-between;
				gap: 1em;
				margin-top: 3em;
				font-size: 0.85em;
			}
			.series-nav .next {
				margin-left: auto;
				text-align: right;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				</div>
				<div class="prose">
					<div class="title">
						<div class="meta">
							<a href={withBase(`/categories/${category}/`)}>{CATEGORIES[category].label}</a>
							{' · '}
							<FormattedDate date={pubDate} />
							{
								updatedDate && (
									<>
										{' · 수정 '}
										<FormattedDate date={updatedDate} />
									</>
								)
							}
							{draft && <span class="draft">초안</span>}
						</div>
						<h1>{title}</h1>
						<TagList tags={tags} />
						<hr />
					</div>

					{
						series && (
							<nav class="series" aria-label="시리즈 목차">
								<a href={withBase(`/series/${slugify(series)}/`)}>
									<strong>{series}</strong>
								</a>{' '}
								시리즈 ({seriesIndex + 1}/{seriesPosts.length})
								<ol>
									{seriesPosts.map((post) => (
										<li class={post.id === id ? 'current' : undefined}>
											{post.id === id ? (
												post.data.title
											) : (
												<a href={withBase(`/blog/${post.id}/`)}>{post.data.title}</a>
											)}
										</li>
									))}
								</ol>
							</nav>
						)
					}

					<slot />

					{
						(prev || next) && (
							<nav class="series-nav" aria-label="시리즈 이전·다음 글">
								{prev && <a href={withBase(`/blog/${prev.id}/`)}>← {prev.data.title}</a>}
								{next && (
									<a class="next" href={withBase(`/blog/${next.id}/`)}>
										{next.data.title} →
									</a>
								)}
							</nav>
						)
					}
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
