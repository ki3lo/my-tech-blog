---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE, withBase } from '../consts';
import { getPosts } from '../utils/posts';

const posts = await getPosts();
const countOf = (key: string) => posts.filter((post) => post.data.category === key).length;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<h1>{SITE_TITLE}</h1>
				<p>{SITE_DESCRIPTION}</p>
			</section>

			<section>
				<h2>카테고리</h2>
				<ul class="categories">
					{
						Object.entries(CATEGORIES).map(([key, { label, description }]) => (
							<li>
								<a href={withBase(`/categories/${key}/`)}>
									<strong>{label}</strong>
									<span class="count">{countOf(key)}</span>
									<p>{description}</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>

			<section>
				<h2>최근 글</h2>
				<PostList posts={posts.slice(0, 5)} />
				{posts.length > 5 && <p><a href={withBase('/blog/')}>전체 글 보기 →</a></p>}
			</section>
		</main>
		<Footer />
	</body>
</html>
<style>
	.intro h1 {
		font-size: 2.4em;
	}
	.intro p {
		color: rgb(var(--gray));
	}
	section + section {
		margin-top: 2.5em;
	}
	h2 {
		font-size: 1.4em;
	}
	.categories {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 0.75em;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.categories a {
		display: block;
		height: 100%;
		box-sizing: border-box;
		padding: 0.9em 1em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 10px;
		background: white;
		color: rgb(var(--black));
		text-decoration: none;
	}
	.categories a:hover {
		border-color: var(--accent);
	}
	.categories p {
		margin: 0.3em 0 0;
		color: rgb(var(--gray));
		font-size: 0.75em;
		line-height: 1.5;
	}
	.count {
		float: right;
		color: rgb(var(--gray));
		font-size: 0.8em;
	}
</style>
